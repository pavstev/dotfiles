# dotfiles settings: one NAME="value" line each. Your copy is
# ~/.config/dotfiles/settings (mode 600, never in git). Change it with the menu,
# `dots settings`, or by hand. An empty value means the default.
# A value stays on one line, without " \ $ or `. Notes go on their own lines.

# Your name and email for git commits (dots writes them to ~/.gitconfig.local).
GIT_NAME=""
GIT_EMAIL=""

# owner or shared (AGENTS.md "Profiles"). Empty: owner when your private rules
# (~/.config/dotfiles/owner.md) exist, else shared.
PROFILE=""

# Which presets (claude/presets/) are on: all, none, or names split by spaces, for
# example: workflow clock plain-writing. Empty: the owner profile gets every preset,
# the shared profile every preset except ship-to-main. A preset that is off costs no tokens.
PRESETS=""

# Your time zone as an IANA name, for example Europe/Berlin. Empty: the system zone.
TIMEZONE=""

# Your Claude plan, which sets the weekly pace budget: pro, max5, max20, team, api or
# unknown. Empty: unknown (no pace budget until the status line reports one).
PLAN=""

# The days you work, for the weekly pace: names or ranges, for example mon-fri,
# mon-sat or sun-thu. Empty: mon-fri.
WORK_DAYS=""

# The weekly use (percent, 50 to 100) where the pace turns critical: no more helpers,
# and autopilot waits for the weekly reset. Empty: 85.
PACE_CRITICAL=""

# Colors of the status line, dots output and the Opencode theme: copper or plain
# (no colors, no Opencode theme). Empty: copper.
THEME=""

# The optional look changes, split by spaces: starship (the Starship prompt),
# editor (the VS Code and Cursor settings: theme, Nerd Font, keys) and font (the Nerd
# Font and the Apple Terminal look, macOS). none: keep your own look. Empty: not asked
# yet, so all are off and the next dots run at a terminal asks once.
LOOKS=""

# Guard check ids to turn off (GUARD_OFF) or to run in shadow mode, which logs what
# would have blocked and lets it through (GUARD_SHADOW). Split by spaces or commas, for
# example: G10 G13. Empty: none. The env var of the same name wins for one run.
GUARD_OFF=""
GUARD_SHADOW=""

# Cloudflare docs search (an MCP server) in Cursor: on or off. Empty: off.
# MCP servers are opt-in on every profile.
CURSOR_MCP=""

# Cloudflare docs search (an MCP server) in Opencode: on or off. Empty: off.
# MCP servers are opt-in on every profile. DOTFILES_MCP=on turns this on too.
OPENCODE_MCP=""

# Project paths whose .opencode/ should mirror the global Opencode config (agents
# linked from ~/.config/opencode/agents, opencode.jsonc linked to the global one).
# Absolute paths; a leading ~ means your home folder. Split by spaces.
# DOTFILES_PROJECTS does the same for one run. Empty: no project configs are created.
OPENCODE_PROJECTS=""

# The Java folder that new shells use as JAVA_HOME (the folder with bin/java).
# Empty: dots sets no JAVA_HOME.
JAVA_HOME=""

# Setup steps that dots always skips, split by spaces. The names are the steps in
# rust/agent-config/src/dots/install/mod.rs (STEPS), for example: 70-macos-defaults (on Linux the macOS-only
# steps 70, 72 and 75 skip on their own)
SKIP_STEPS=""

# Words the repo's git hooks keep out of every commit, split by spaces. Your git
# email, your full git name and the name written as one word count too.
PRIVATE_PROJECTS=""
PRIVATE_WORDS=""

# Host names the word checks skip, split by spaces or commas (a link to your own site may
# hold a private word). Only the host is removed from the text, never a path. An entry with
# a character outside letters, digits, dot and hyphen is ignored. Empty: no host is skipped.
PUBLIC_HOSTS=""

# The SSH host (a name from ~/.ssh/config) where scripts/os-check.sh runs the Linux
# check in podman or docker. Empty: it uses podman or docker on this machine.
TEST_HOST=""
