#!/usr/bin/env bash
# ============================================================================
#  scripts/agent-config — one entry point for the config generator.
#
#  Runs the Rust build (rust/agent-config) when there is one, so a machine
#  needs no Python. The build is made on first use when cargo works, and made
#  again when lib.rs, main.rs, Cargo.toml or Cargo.lock are newer than the
#  binary. With no usable binary it falls back to scripts/agent-config.py
#  (python3). A stale binary is still used when the rebuild fails and there is
#  no python3.
#
#    scripts/agent-config cursor --profile owner
#    AGENT_CONFIG_IMPL=python scripts/agent-config opencode   # force Python
#    AGENT_CONFIG_IMPL=rust   scripts/agent-config opencode   # force Rust
#    scripts/agent-config --bins                              # build every Rust bin, then stop
#
#  The build makes every bin of the crate (the hooks and the skill tools too), so
#  `dots` is the one place that builds. claude/hooks/rust-bin only runs a bin that
#  is newer than the sources and never builds.
# ============================================================================
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=setup-lib.sh
. "$HERE/setup-lib.sh"

CRATE="$REPO/rust/agent-config"
TARGET="$CRATE/target"
EXE=agent-config
is_windows && EXE=agent-config.exe
BIN="$TARGET/release/$EXE"
IMPL="${AGENT_CONFIG_IMPL:-auto}"

stale() {
  [[ ! -x "$BIN" ]] && return 0
  [[ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" "$CRATE/themes" \
    -newer "$BIN" -type f 2>/dev/null | head -1)" ]]
}

# build: make every bin in the crate's own target dir, with the lock file as it is. When that
# fails (one tool does not build on this box), make agent-config alone, so the config
# generator still runs. RUSTUP_AUTO_INSTALL=0: with no toolchain on this HOME (a temp HOME,
# a bare box) fail now, never download one. On success the bins are touched, because cargo
# leaves a bin alone when only an unrelated file changed, and rust-bin takes an older bin
# for stale.
cargo_build() {
  RUSTUP_AUTO_INSTALL=0 cargo build --release --quiet --locked --target-dir "$TARGET" \
    --manifest-path "$CRATE/Cargo.toml" "$@" >&2
}

build() {
  have cargo || return 1
  echo "agent-config: building the Rust binaries (first run takes a few minutes)" >&2
  if cargo_build --bins; then
    local f
    for f in "$TARGET"/release/*; do
      [[ -f "$f" && -x "$f" ]] && touch "$f"
    done
  else
    cargo_build --bin agent-config || return 1
    [[ -x "$BIN" ]] && touch "$BIN"
  fi
  [[ -x "$BIN" ]]
}

run_rust() {
  export DOTFILES_REPO="$REPO"
  exec "$BIN" "$@"
}

run_python() {
  have python3 || { echo "agent-config: need the Rust build (cargo) or python3" >&2; exit 1; }
  exec python3 "$HERE/agent-config.py" "$@"
}

if [[ "${1:-}" == --bins ]]; then
  [[ -d "$CRATE" ]] || exit 0
  if ! stale || build; then exit 0; fi
  echo "agent-config: no Rust build (the Python tools run instead)" >&2
  exit 0
fi

[[ "$IMPL" == python ]] && run_python "$@"

if [[ -d "$CRATE" ]]; then
  if ! stale || build; then run_rust "$@"; fi
  if [[ -x "$BIN" ]] && ! have python3; then
    echo "agent-config: rebuild failed, running the older Rust binary" >&2
    run_rust "$@"
  fi
fi

if [[ "$IMPL" == rust ]]; then
  echo "agent-config: AGENT_CONFIG_IMPL=rust but the Rust binary is not available" >&2
  exit 1
fi
run_python "$@"
