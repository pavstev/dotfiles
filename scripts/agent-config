#!/usr/bin/env bash
# ============================================================================
#  scripts/agent-config — one entry point for the config generator.
#
#  Runs the Rust build (rust/agent-config). The build is made on first use when
#  cargo works, and made again when anything under src/ or themes/, Cargo.toml
#  or Cargo.lock is newer than the binary. A stale binary is still used when the
#  rebuild fails. With no binary and no cargo it says "Run: dots" and exits 127
#  (`dots` installs Rust when it is missing).
#
#    scripts/agent-config cursor --profile owner
#    scripts/agent-config --bins     # build every Rust bin, then stop (always exits 0). It builds
#                                    # again when any [[bin]] is missing or older than the sources.
#
#  The build makes every bin of the crate (the hooks and the skill tools too), so
#  `dots` is the one place that builds. claude/hooks/rust-bin only runs the bin
#  that is there and never builds.
# ============================================================================
set -u

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
# shellcheck source=setup-lib.sh
. "$HERE/setup-lib.sh"

CRATE="$REPO/rust/agent-config"
TARGET="$CRATE/target"
EXE=agent-config
is_windows && EXE=agent-config.exe
BIN="$TARGET/release/$EXE"

stale() {
  [[ ! -x "$BIN" ]] && return 0
  [[ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" "$CRATE/themes" \
    -newer "$BIN" -type f 2>/dev/null | head -1)" ]]
}

# build: make every bin in the crate's own target dir, with the lock file as it is. When that
# fails (one tool does not build on this box), make agent-config alone, so the config
# generator still runs. RUSTUP_AUTO_INSTALL=0: with no toolchain on this HOME (a temp HOME,
# a bare box) fail now, never download one. On success the bins are touched, because cargo
# leaves a bin alone when only an unrelated file changed, and rust-bin takes an older bin
# for stale.
cargo_build() {
  RUSTUP_AUTO_INSTALL=0 cargo build --release --quiet --locked --target-dir "$TARGET" \
    --manifest-path "$CRATE/Cargo.toml" "$@" >&2
}

build() {
  have cargo || return 1
  echo "agent-config: building the Rust binaries (first run takes a few minutes)" >&2
  if cargo_build --bins; then
    local f
    for f in "$TARGET"/release/*; do
      [[ -f "$f" && -x "$f" ]] && touch "$f"
    done
  else
    cargo_build --bin agent-config || return 1
    [[ -x "$BIN" ]] && touch "$BIN"
  fi
  [[ -x "$BIN" ]]
}

run_rust() {
  export DOTFILES_REPO="$REPO"
  exec "$BIN" "$@"
}

# bin_names: the name of each [[bin]] in Cargo.toml, one per line.
bin_names() {
  local line in_bin=0
  while IFS= read -r line; do
    line="${line#"${line%%[![:space:]]*}"}"; line="${line%$'\r'}"
    case "$line" in
      "[[bin]]") in_bin=1 ;;
      "["*) in_bin=0 ;;
      name*) if ((in_bin)); then line="${line#*=}"; printf '%s\n' "${line//[\" ]/}"; fi ;;
    esac
  done <"$CRATE/Cargo.toml"
}

# bins_stale: any [[bin]] is missing in target/release or older than the sources. The same
# rule as the `bins-fresh` check of `dots doctor`. After a partial build failure only
# agent-config is built and touched, so `stale` alone would call the rest fresh.
bins_stale() {
  local n f
  while IFS= read -r n; do
    f="$TARGET/release/$n"; is_windows && f="$f.exe"
    [[ -f "$f" ]] || return 0
    [[ -n "$(find "$CRATE/src" "$CRATE/Cargo.toml" "$CRATE/Cargo.lock" "$CRATE/themes" \
      -newer "$f" -type f 2>/dev/null | head -1)" ]] && return 0
  done < <(bin_names)
  return 1
}

if [[ "${1:-}" == --bins ]]; then
  [[ -d "$CRATE" ]] || exit 0
  if { ! stale && ! bins_stale; } || build; then exit 0; fi
  echo "agent-config: no Rust build. Run: dots" >&2
  exit 0
fi

if [[ -d "$CRATE" ]]; then
  if ! stale || build; then run_rust "$@"; fi
  if [[ -x "$BIN" ]]; then
    echo "agent-config: rebuild failed, running the older Rust binary" >&2
    run_rust "$@"
  fi
fi

echo "agent-config: no Rust build and no cargo. Run: dots" >&2
exit 127
