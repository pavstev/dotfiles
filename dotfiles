#!/usr/bin/env bash
# ============================================================================
#  ./dotfiles: the one command (alias dots): pull latest, link files, provision.
#
#  A thin shim. It runs the Rust `dots` (rust/agent-config/src/dots/), built here
#  on first use and again when its sources change (about 1 to 2 minutes). With no
#  Rust it installs one with rustup first (on Windows the GNU host, no Visual Studio).
#  The find-or-install-Rust-then-build code is ensure_rust_bin in scripts/setup-lib.sh;
#  scripts/tools uses the same one. If Rust cannot be installed or the build fails it
#  says why and exits 1.
#  Arguments: dots [-v] [settings | doctor].
#
#    DOTS_BIN=<path> ./dotfiles    # run this dots binary (tests), no build
# ============================================================================
set -u

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/setup-lib.sh
. "$REPO/scripts/setup-lib.sh"

no_rust() { printf '!  dots: %s\n' "$1" >&2; exit 1; }

if [[ -n "${DOTS_BIN:-}" ]]; then
  [[ -x "$DOTS_BIN" ]] || no_rust "DOTS_BIN is not a program: $DOTS_BIN"
  BIN="$DOTS_BIN"
else
  ensure_rust_bin "$REPO" dots dots || exit 1
  BIN="$RUST_BIN"
fi

export DOTFILES_REPO="$REPO"
is_windows || exec "$BIN" "$@"
# Windows locks a running .exe, so the restart after a pull could not rebuild dots.exe.
# Run a copy of it instead.
run="$(mktemp -d "${TMPDIR:-/tmp}/dots-run.XXXXXX")" || exit 1
trap 'rm -rf "$run"' EXIT
cp "$BIN" "$run/dots.exe" || no_rust "couldn't copy $BIN"
"$run/dots.exe" "$@"
