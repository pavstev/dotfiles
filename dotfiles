#!/usr/bin/env bash
# ============================================================================
#  ./dotfiles — the one command: pull latest, link files, provision tools.
#
#  Safe to run repeatedly on any machine, in either role:
#    - the machine you EDIT on: local commits make the pull a harmless no-op,
#      then linking/provisioning just re-confirms current state.
#    - a machine that only PULLS: fast-forwards, links what's new, installs
#      whatever the Brewfile/toolchain steps are missing.
#
#  No daemon. Just run it again whenever you want to sync.
#  One option: `dots settings` (or `dots private`) opens the settings menu
#  (scripts/settings.sh), then refreshes the links and the Cursor rule.
# ============================================================================
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO
export DOTFILES="$REPO"

. "$REPO/scripts/setup-lib.sh" 2>/dev/null \
  || { printf '!! scripts/setup-lib.sh missing or unreadable — repo incomplete?\n' >&2; exit 1; }
brew_env   # brew and gum on PATH, also in a bare shell

ASK_SETTINGS="" OWN_STEPS=""
case "${1:-}" in
  "") ;;
  settings|private)
    ASK_SETTINGS=1
    # Only the Cursor step runs then, to pick up the new settings.
    if [[ -z "${DOTFILES_STEPS+set}" ]]; then export DOTFILES_STEPS=60-cursor; OWN_STEPS=1; fi ;;
  *) printf 'usage: dots [settings]\n' >&2; exit 2 ;;
esac

if [[ -n "${DOTFILES_PULLED:-}" ]]; then
  ok "pulled the latest version"   # the run before this one printed the step
else
  step "Pulling latest"
  before="$(git -C "$REPO" rev-parse HEAD 2>/dev/null)"
  # No autostash and no password prompt. A pull that would change a file edited
  # here stops, instead of leaving conflict markers in a live config.
  if GIT_TERMINAL_PROMPT=0 git -C "$REPO" -c rebase.autoStash=false -c merge.autoStash=false \
      pull --ff-only --no-rebase --quiet; then
    # New commits can change this script. Run the new one for the rest.
    if [[ "$(git -C "$REPO" rev-parse HEAD 2>/dev/null)" != "$before" ]]; then
      exec env DOTFILES_PULLED=1 bash "$REPO/dotfiles" "$@"
    fi
    ok "up to date"
  else
    warn "couldn't pull (no network, local commits, or a changed file), so this run uses what is here"
    changed="$(git -C "$REPO" status --porcelain --untracked-files=no 2>/dev/null | cut -c4- | tr '\n' ' ')"
    if [[ -n "$changed" ]]; then info "changed here: $changed"; fi
    if [[ " $changed " == *" claude/CLAUDE.md "* ]]; then
      info "keep your own rules in your private rules (dots settings), not in claude/CLAUDE.md"
    fi
  fi
fi

# A person at a terminal gets the guided setup. Its menus need gum.
if at_terminal && ! have gum; then
  step "Getting ready"
  if ensure_brew && brew install --quiet gum >/dev/null 2>&1; then
    ok "menus ready"
  else
    warn "couldn't install gum, so the questions use plain text"
  fi
fi

# The first run is the one without a settings file (AGENTS.md "Settings").
step "Git identity"
FIRST_RUN=""
if [[ ! -f "$DOTFILES_SETTINGS" ]]; then
  FIRST_RUN=1
  is_macos && machine="Mac" || machine="Linux machine"
  banner "🦴 dotfiles" "This sets up your $machine for Claude Code and Cursor." \
    "A few questions first, then about 20 to 40 minutes of installs." \
    "Use ↑ ↓ to move and Enter to pick."
fi
name="$(setting GIT_NAME)" email="$(setting GIT_EMAIL)"
# --includes: also read ~/.gitconfig.local, which ~/.gitconfig includes.
[[ -n "$name" ]] || name="$(git config --global --includes user.name 2>/dev/null || true)"
[[ -n "$email" ]] || email="$(git config --global --includes user.email 2>/dev/null || true)"
[[ -n "$name" ]] || name="$(ask_text "👤 Your name, for git commits" "Jane Doe")" || name=""
[[ -n "$email" ]] || email="$(ask_email "✉️  Your email, for git commits" "jane@example.com")" || email=""
if [[ -n "$name" && -n "$email" ]]; then
  [[ "$(setting GIT_NAME)" == "$name" ]] || set_setting GIT_NAME "$name" || warn "couldn't save GIT_NAME"
  [[ "$(setting GIT_EMAIL)" == "$email" ]] || set_setting GIT_EMAIL "$email" || warn "couldn't save GIT_EMAIL"
  git_identity "$name" "$email"
else
  warn "no git name or email given. Run dots settings in a terminal to set them."
fi
export DOTFILES_FIRST_RUN="$FIRST_RUN"

# The settings menu (scripts/settings.sh): on the first run at a terminal, or any
# time with: dots settings
if [[ -n "$FIRST_RUN$ASK_SETTINGS" ]] && at_terminal; then
  bash "$REPO/scripts/settings.sh" || warn "settings not finished. Run: dots settings"
elif [[ -n "$ASK_SETTINGS" ]]; then
  warn "dots settings asks questions, so run it in a terminal"
fi

PROFILE="$(dotfiles_profile)"
export DOTFILES_PROFILE="$PROFILE"

# An optional extra, offered once: on the first run, at a terminal. "No" comes first.
if is_macos && [[ -n "$FIRST_RUN" ]] && at_terminal && [[ ! -d /Applications/Claude.app ]]; then
  step "Extras"
  no="⏭️  No, skip it" app="🖥️  Yes, install the Claude desktop app"
  if [[ "$(ask_one "✨ Install the Claude desktop app too?" "$no" "$app")" == "$app" ]]; then
    if spin "Installing the Claude app" brew install --cask --quiet claude; then
      ok "Claude desktop app installed"
    else
      warn "couldn't install the Claude app. Try later: brew install --cask claude"
    fi
  fi
fi

step "Linking files"
# Explicit allow-list: relative paths under home/ map 1:1 to the same
# relative path under $HOME. Anything NOT listed here is never touched —
# secrets and per-machine state (gh hosts.yml, atuin data dir, VS Code/
# Cursor caches, Raycast tokens, Docker/OrbStack/Cloudflared state, …)
# simply live outside this list.
LINKS=()
# AeroSpace is a Mac window manager.
if is_macos; then LINKS+=(".config/aerospace"); fi
LINKS+=(
  ".config/atuin"
  ".config/bat"
  ".config/btop"
  ".config/fastfetch"
  ".config/gh/config.yml"
  ".config/ghostty"
  ".config/lazygit"
  ".config/starship.toml"
  ".config/tealdeer"
  ".config/yazi"
  ".config/zsh"
  ".gitconfig"
  ".zshrc"
)
for item in "${LINKS[@]}"; do
  link_item "$REPO/home/$item" "$HOME/$item"
done

# VS Code and Cursor settings: the repo keeps them under their Mac path in home/.
# The same files link to where each OS looks for them.
if is_macos; then editor_cfg="Library/Application Support"; else editor_cfg=".config"; fi
for app in Code Cursor; do
  for f in settings.json keybindings.json; do
    link_item "$REPO/home/Library/Application Support/$app/User/$f" "$HOME/$editor_cfg/$app/User/$f"
  done
done

step "Linking Claude config -> ~/.claude"
info "profile: $PROFILE (AGENTS.md \"Profiles\")"
CLAUDE_SRC="$REPO/claude"
CLAUDE_DST="$HOME/.claude"
if [[ -d "$CLAUDE_SRC" ]]; then
  mkdir -p "$CLAUDE_DST" 2>/dev/null || warn "couldn't create $CLAUDE_DST"
  # Per-item, never the whole dir — Claude Code recreates ~/.claude and
  # writes session state there.
  for d in agents hooks output-styles; do
    link_item "$CLAUDE_SRC/$d" "$CLAUDE_DST/$d"
  done
  for f in CLAUDE.md statusline.sh; do
    link_item "$CLAUDE_SRC/$f" "$CLAUDE_DST/$f"
  done
  # settings.json is built, not linked: the repo base plus the private layer
  # (~/.config/dotfiles/claude-settings.json). Claude writes this file itself; what
  # it changed since the last build moves into the private layer first.
  python3 "$REPO/scripts/agent-config.py" claude-settings build \
    || warn "couldn't build ~/.claude/settings.json, so it stays as it was"
  # The owner's private rules (never in the repo) load as a Claude user rule.
  rule="$CLAUDE_DST/rules/owner.md"
  if [[ "$PROFILE" == owner && -f "$OWNER_MD" ]]; then
    link_item "$OWNER_MD" "$rule"
  else
    if [[ "$PROFILE" == owner ]]; then
      warn "owner profile, but no private rules on this Mac. Add them with: dots settings"
    fi
    if [[ -L "$rule" && "$(readlink "$rule")" == "$OWNER_MD" ]]; then
      rm -f "$rule" && ok "removed the owner rules link"
    fi
  fi
else
  warn "$CLAUDE_SRC missing — skipping Claude config link"
fi

step "Claude/Cursor skills"
if [[ -x "$REPO/claude/skill-sync.sh" ]]; then
  "$REPO/claude/skill-sync.sh" || warn "skill-sync.sh reported an issue — skills may be unlinked"
else
  warn "claude/skill-sync.sh missing or not executable — skipping"
fi

step "Linking Opencode config -> ~/.config/opencode"
# Opencode reads ~/.claude/skills natively (skill-sync above links them), so every
# ps:* skill already works in Opencode, in every project. What remains: the agents
# mirrored from claude/agents, plus permissions and opt-in MCP servers merged into
# ~/.config/opencode/opencode.jsonc. Both are generated/merged, never linked, so the
# user's own opencode.jsonc values win.
if [[ -x "$REPO/scripts/agent-config.py" ]]; then
  python3 "$REPO/scripts/agent-config.py" opencode --profile "$PROFILE" \
    || warn "agent-config.py opencode reported an issue, see above"
else
  warn "scripts/agent-config.py missing or not executable — skipping Opencode config"
fi

if [[ -d "$REPO/scripts/install.d" ]]; then
  # DOTFILES_STEPS="60-cursor ..." runs only the named steps (for temp-HOME tests),
  # also the ones in SKIP_STEPS: the env wins for one run. Else SKIP_STEPS in the
  # settings names steps that never run on this Mac (also in dots settings).
  skip_steps=" "
  if [[ -z "${DOTFILES_STEPS:-}" || -n "$OWN_STEPS" ]]; then skip_steps=" $(setting SKIP_STEPS) "; fi
  for f in "$REPO"/scripts/install.d/*.sh; do
    [[ -f "$f" ]] || continue
    s="$(basename "$f" .sh)"
    if [[ -n "${DOTFILES_STEPS:-}" && " $DOTFILES_STEPS " != *" $s "* ]]; then
      continue
    fi
    if [[ "$skip_steps" == *" $s "* ]]; then
      info "$s skipped (Steps to skip, in dots settings)"
      continue
    fi
    bash "$f" || warn "$s.sh exited non-zero — see output above"
  done
fi

printf '\n'
brew_env   # step 10 can install it during this run
if ! have brew; then
  warn "Homebrew is missing, so the apps and tools did not install. Fix the error above, then run dots again."
elif [[ -n "$FIRST_RUN" ]]; then
  is_macos && new_shell="Open a new Terminal window." || new_shell="Open a new terminal, or run: exec zsh"
  banner "✅ All set" "$new_shell" \
    "Claude Code: run claude, then type /ps: to see the skills." \
    "Cursor: open the chat, then type /ps: to see the same skills."
fi
ok "dotfiles: done"
