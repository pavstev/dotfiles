// fastfetch config — symlinked from this repo.
// Copper-on-stone palette; uses Nerd Font icons.
// Docs: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "macos",
    "color": {
      "1": "38;5;173",   // copper
      "2": "38;5;179"    // amber
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;5;173",    // copper for labels
      "title": "1;38;5;173"  // bold copper for title
    }
  },
  "modules": [
    "title",
    "separator",
    { "type": "os",      "key": " OS",      "keyColor": "38;5;173" },
    { "type": "host",    "key": " Host",    "keyColor": "38;5;173" },
    { "type": "kernel",  "key": " Kernel",  "keyColor": "38;5;173" },
    { "type": "uptime",  "key": "󱦟 Uptime",  "keyColor": "38;5;173" },
    { "type": "shell",   "key": " Shell",   "keyColor": "38;5;173" },
    { "type": "display", "key": " Display", "keyColor": "38;5;173" },
    { "type": "cpu",     "key": " CPU",     "keyColor": "38;5;173" },
    { "type": "gpu",     "key": "󰍛 GPU",     "keyColor": "38;5;173" },
    { "type": "memory",  "key": " RAM",     "keyColor": "38;5;173" },
    { "type": "disk",    "key": "󰋊 Disk",    "keyColor": "38;5;173", "key2": "" },
    { "type": "battery", "key": " Battery", "keyColor": "38;5;173" },
    "break",
    { "type": "colors",  "paddingLeft": 2, "symbol": "circle" }
  ]
}
