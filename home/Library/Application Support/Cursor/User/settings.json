{
  // Symlinked from this repo. Edit here, or in Cursor — same file either way.
  // Mirror of VS Code settings — adjust independently once they diverge.

  // ---- Theme & fonts -------------------------------------------------------
  "workbench.colorTheme": "One Dark Pro",
  "workbench.iconTheme": "vs-seti",
  "editor.fontFamily": "'FiraCode Nerd Font Mono', monospace",
  "editor.fontSize": 13,
  "editor.lineHeight": 1.5,
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'FiraCode Nerd Font Mono'",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,

  // ---- Editor behaviour ----------------------------------------------------
  "editor.tabSize": 2,
  "editor.detectIndentation": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.rulers": [100],
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.wordWrap": "off",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.inlayHints.enabled": "on",
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.stickyScroll.enabled": true,

  // ---- Files ---------------------------------------------------------------
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // ---- Workbench -----------------------------------------------------------
  "workbench.editor.enablePreview": false,
  "workbench.editor.tabSizing": "shrink",
  "workbench.startupEditor": "none",

  // ---- Explorer ------------------------------------------------------------
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // ---- Git -----------------------------------------------------------------
  "git.autofetch": true,
  "git.confirmSync": false,

  // ---- Language-specific formatters ----------------------------------------
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go"
  },

  // ---- Cursor agent ----------------------------------------------------------
  // Mirrors the deny list in claude/settings.json: AI features never see these.
  "cursor.general.globalCursorIgnoreList": ["**/.env", "**/.env.*", "**/secrets/**"],

  // ---- Misc ----------------------------------------------------------------
  "extensions.autoUpdate": false,
  "telemetry.telemetryLevel": "off"
}
