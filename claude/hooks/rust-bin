#!/usr/bin/env bash
# ============================================================================
#  rust-bin [--hook] <name> [args...]: run a dotfiles tool as its Rust binary.
#
#  It never builds anything: a hook or a skill call must not wait on cargo.
#  `dots` builds the binaries (scripts/agent-config --bins). It runs the binary
#  when there is one, and checks nothing else, so a call costs no more than the
#  binary itself. With no binary:
#
#    ~/.claude/hooks/rust-bin --hook guard pretool    # a hook exits 0, silent
#    ~/.claude/hooks/rust-bin spawn --prompt-file p.md # a skill call says "Run: dots", exit 127
#
#  Windows (Git Bash) runs <name>.exe. stdin, stdout, stderr and the exit code pass through.
#  It runs on every hook, so it starts no subshell and no other program: plain POSIX sh,
#  parameter expansion and `[` only (bash runs it the same).
# ============================================================================
set -u

hook=0
if [ "${1:-}" = "--hook" ]; then hook=1; shift; fi
name="${1:-}"
if [ -z "$name" ]; then echo "usage: rust-bin [--hook] <name> [args...]" >&2; exit 2; fi
shift

# This file is linked as ~/.claude/hooks/rust-bin. The kernel resolves <its folder>/../.. through
# that link, the same as `cd -P` does, so the repo is found without a subshell.
case "$0" in */*) HERE="${0%/*}" ;; *) HERE=. ;; esac
REPO="$HERE/../.."
[ -f "$REPO/rust/agent-config/Cargo.toml" ] || REPO="${DOTFILES_REPO:-$HOME/dotfiles}"
CRATE="$REPO/rust/agent-config"

# the same test as is_windows in scripts/setup-lib.sh; bash's $OSTYPE saves the `uname` call
exe="$name"
case "${OSTYPE:-$(uname -s 2>/dev/null)}" in
  msys* | cygwin* | MINGW* | MSYS* | CYGWIN* | Windows_NT) exe="$name.exe" ;;
esac
BIN="$CRATE/target/release/$exe"

if [ -x "$BIN" ]; then exec "$BIN" "$@"; fi
[ "$hook" = 1 ] && exit 0 # a hook fails open
echo "rust-bin: no Rust binary for '$name'. Run: dots" >&2
exit 127
