{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "model": "opusplan",
  "effortLevel": "high",
  "autoCompactWindow": 350000,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "subagentPromptCacheTtl": "1h",
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -r)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Read(~/dotfiles/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "SuggestPluginInstall",
      "SearchPlugins",
      "SuggestSkills",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__45831831-e75c-46d3-a3ed-84c1cb884d7b__*",
      "mcp__a16997c4-316a-4f39-816e-0b9b5ac48d05__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_PDF_Viewer__*",
      "mcp__plugin_pdf-viewer_pdf__*",
      "mcp__computer-use__*",
      "mcp__plugin_desktop-commander_desktop-commander__*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|EnterPlanMode|CronCreate|ScheduleWakeup|Skill|AskUserQuestion|SubagentHandback|mcp__ccd_session_mgmt__archive_session|mcp__Claude_Browser__.*|mcp__claude-in-chrome__.*|Bash|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py posttool",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py subagentstop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py posttoolfailure",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/guard.py || exit 0; python3 ~/.claude/hooks/guard.py prompt",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "cloudflare@cloudflare": false,
    "data@synced": false,
    "brightdata-plugin@synced": false,
    "cowork-plugin-management@synced": false,
    "cowork-plugin-management@inline": false,
    "productivity@synced": false,
    "productivity@inline": false,
    "pdf-viewer@synced": false,
    "pdf-viewer@inline": false,
    "jev@synced": false,
    "jev@inline": false,
    "adversarial-review@synced": false,
    "adversarial-review@inline": false,
    "engineering@synced": false,
    "engineering@inline": false,
    "design@synced": false,
    "design@inline": false,
    "desktop-commander@synced": false,
    "desktop-commander@inline": false
  },
  "skillOverrides": {
    "anthropic-skills:spark": "user-invocable-only",
    "anthropic-skills:spark-persona-exec-assistant": "user-invocable-only",
    "anthropic-skills:spark-recipe-inbox-zero": "user-invocable-only",
    "anthropic-skills:spark-recipe-invitation-manager": "user-invocable-only",
    "anthropic-skills:spark-recipe-label-organize": "user-invocable-only",
    "productivity:memory-management": "user-invocable-only",
    "productivity:start": "user-invocable-only",
    "productivity:task-management": "user-invocable-only",
    "productivity:update": "user-invocable-only",
    "cowork-plugin-management:cowork-plugin-customizer": "user-invocable-only",
    "cowork-plugin-management:create-cowork-plugin": "user-invocable-only",
    "desktop-commander:ai-tools-setup": "user-invocable-only",
    "desktop-commander:computer-health-check": "user-invocable-only",
    "desktop-commander:knowledge-base": "user-invocable-only",
    "desktop-commander:obsidian-vault": "user-invocable-only",
    "engineering:incident-response": "user-invocable-only",
    "engineering:standup": "user-invocable-only",
    "pdf-viewer:annotate": "user-invocable-only",
    "pdf-viewer:fill-form": "user-invocable-only",
    "pdf-viewer:sign": "user-invocable-only"
  },
  "extraKnownMarketplaces": {
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    }
  },
  "outputStyle": "ELI5",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
