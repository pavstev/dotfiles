{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "effortLevel": "high",
  "autoCompactWindow": 500000,
  "skillListingMaxDescChars": 500,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -r)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Read(~/dotfiles/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(**/node_modules/**)",
      "Read(**/target/**)",
      "Read(**/.venv/**)",
      "Read(**/build/**)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/package-lock.json)",
      "Read(**/yarn.lock)",
      "Read(**/bun.lock)",
      "Read(**/Cargo.lock)",
      "Read(**/uv.lock)",
      "Read(**/poetry.lock)",
      "Read(**/go.sum)",
      "SuggestPluginInstall",
      "SearchPlugins",
      "SuggestSkills",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_PDF_Viewer__*",
      "mcp__plugin_pdf-viewer_pdf__*",
      "mcp__plugin_desktop-commander_desktop-commander__*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/plugins/data/ps-agent-kit/bin/rust-bin statusline",
    "padding": 0
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
