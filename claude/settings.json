{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 365,
  "effortLevel": "high",
  "autoCompactWindow": 300000,
  "skillListingMaxDescChars": 500,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    },
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "subagentPromptCacheTtl": "1h",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --list:*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git branch -r)",
      "Bash(git show:*)",
      "Bash(ls:*)",
      "Bash(eza:*)",
      "Bash(bat:*)",
      "Bash(brew list:*)",
      "Bash(brew info:*)",
      "Read(~/dotfiles/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "SuggestPluginInstall",
      "SearchPlugins",
      "SuggestSkills",
      "mcp__Claude_Code_iOS_Simulator__*",
      "mcp__claude_ai_Google_Drive__*",
      "mcp__claude_ai_PDF_Viewer__*",
      "mcp__plugin_pdf-viewer_pdf__*",
      "mcp__plugin_desktop-commander_desktop-commander__*"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/hooks/rust-bin statusline",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Edit|Write|MultiEdit|EnterPlanMode|CronCreate|ScheduleWakeup|Skill|AskUserQuestion|SubagentHandback|mcp__ccd_session_mgmt__archive_session|mcp__Claude_Browser__.*|mcp__claude-in-chrome__.*|Bash|Read|Grep|mcp__.*([Ss]end|[Pp]ost|[Rr]eply|[Ff]orward|[Cc]omment|[Cc]reate_?[Ii]ssue|[Uu]pdate_?[Ii]ssue|[Cc]reate_?[Pp]ull_?[Rr]equest|[Uu]pdate_?[Pp]ull_?[Rr]equest|[Pp]ush_?[Ff]iles|[Cc]reate_?[Oo]r_?[Uu]pdate_?[Ff]ile|[Pp]ublish|[Uu]pload|[Ss]ubmit_?[Rr]eview|[Dd]raft|[Mm]essage|[Tt]weet|[Nn]otify).*",
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard pretool",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard posttool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook proj format",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard stop",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard subagentstop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard posttoolfailure",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -r ~/.claude/hooks/rust-bin || exit 0; sh ~/.claude/hooks/rust-bin --hook guard prompt",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
